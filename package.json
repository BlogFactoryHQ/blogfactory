{
  "name": "blogfactory",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test:server": "npm run test:self --workspace=server",
    "test:postgres": "npm run test:postgres --workspace=server",
    "test:postgres:product-seo": "npm run test:postgres:product-seo --workspace=server",
    "test:mcp:pilot": "npm run test:mcp:pilot --workspace=server",
    "billing:catalog": "bun --env-file=.env run server/src/scripts/provision-polar-catalog.ts",
    "billing:webhook": "bun --env-file=.env run server/src/scripts/provision-polar-webhook.ts",
    "billing:grant-transition": "bun --env-file=.env run server/src/scripts/grant-transition-entitlements.ts",
    "auth:migrate-workos": "bun --env-file=.env run server/src/scripts/migrate-users-to-workos.ts",
    "cron:deploy": "npx wrangler deploy --config wrangler.cron.jsonc",
    "cron:dry-run": "npx wrangler deploy --config wrangler.cron.jsonc --dry-run",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.8",
    "zod": "4.6.7"
  }
}
