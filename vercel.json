{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index.js"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|mcp-review\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
