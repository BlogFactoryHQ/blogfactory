{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.blogfactory.io" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index.js"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.blogfactory.io" }],
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|help\\.html$|docs\\.html$|mcp-review\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
