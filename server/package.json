{
  "name": "@editorial-flow/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test:self": "bun run src/run-self-tests.ts",
    "test:postgres": "bun run src/run-postgres-integration.ts",
    "test:mcp:pilot": "bun run src/run-mcp-pilot-smoke.ts",
    "credentials:check": "bun run src/credentials-check.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vercel/functions": "^3.7.3",
    "bcryptjs": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "framer-api": "^0.1.17",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
