    "framer-api": "^0.1.17",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.30.0"
  }
