# ── Auth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme-generate-a-random-secret
ADMIN_EMAILS=hello@ortakalan.media,bora@inpocket.ai
API_KEY_ENCRYPTION_SECRET=changeme-generate-a-second-random-secret
# Optional browser origins for the private MCP token pilot, comma-separated.
MCP_ALLOWED_ORIGINS=https://blogfactory.io
# Leave all three unset to disable OAuth; partial configuration fails closed.
# WORKOS_AUTHKIT_ISSUER=https://YOUR-SUBDOMAIN.authkit.app
# MCP_RESOURCE_URL=https://blogfactory.io/mcp
# WORKOS_API_KEY=sk_REPLACE_WITH_WORKOS_SECRET

# ── Protected cron endpoint ─────────────────────────
# Same value must be set as the Cloudflare Worker secret.
CRON_SECRET=changeme-generate-a-third-random-secret
OPENROUTER_WEBHOOK_SECRET=changeme-generate-a-fourth-random-secret
RSS_CRON_MAX_FEEDS=1
RSS_CRON_MAX_POSTS_PER_FEED=1
RSS_FEED_RUN_LEASE_MINUTES=15

# ── Database ──────────────────────────────────────────
# Neon (or any PostgreSQL) connection string
# Get a free Neon DB at https://neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/editorial-flow?sslmode=require

# ── Object Storage ────────────────────────────────────
# Option A: Cloudflare R2 (recommended for production)
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-r2-access-key
# S3_SECRET_ACCESS_KEY=your-r2-secret-key
# S3_BUCKET=editorial-flow
# S3_REGION=auto
# S3_PUBLIC_URL=https://pub-xxx.r2.dev  # optional CDN URL

# Option B: Local MinIO (for local dev with docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=editorial-flow
S3_REGION=us-east-1

# ── AI / Integrations ─────────────────────────────────
# OpenRouter and Google Gemini API keys are stored per user
# from Settings > API Keys. Do not configure shared provider
# keys for the private beta.

# Google Search Console OAuth
# Register this redirect URI in Google Cloud:
# https://YOUR_DOMAIN/api/search-console/oauth/callback
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# Optional override for local/proxy setups
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=

# ── Wix Integration (optional) ───────────────────────
WIX_API_KEY=
WIX_SITE_ID=
WIX_MEMBER_ID=

# ─────────────────────────────────────────────────────
# NOTE: VITE_API_URL is NOT needed — the frontend calls
# /api relative URLs which Vercel routes automatically.
# In local dev, Vite proxies /api → http://localhost:3000
# Production web builds require the real public HTTPS waitlist URL.
VITE_WAITLIST_URL=
# ─────────────────────────────────────────────────────
