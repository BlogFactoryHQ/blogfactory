{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogfactory-cron",
  "main": "cloudflare/cron-worker.ts",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "vars": {
    "CRON_BASE_URL": "https://app.blogfactory.io"
  }
}
